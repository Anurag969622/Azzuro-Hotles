# ─── Server Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
#
# Project URL — public, safe to reference on server
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key — NEVER expose in frontend code or commit to git
# Used for privileged DB operations that bypass Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon (public) key — also kept here for server-side read operations
SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Direct PostgreSQL connection (for pg.Pool — faster than Supabase HTTP) ────
# Find in: Supabase Dashboard → Settings → Database → Connection String
# Use the "URI" format. Replace [YOUR-PASSWORD] with your DB password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ── AI Worker ─────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
# Shared secret between Node and Python services (generate with: openssl rand -hex 32)
AI_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Data Ingestion ────────────────────────────────────────────────────────────
MAX_IMPORT_FILE_SIZE_MB=10
AI_BATCH_SIZE=50

# ── Automation ────────────────────────────────────────────────────────────────
# IMPORTANT: Keep false until written authorisation for automated collection is confirmed
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_AUTH_TOKEN=

# ── Booking.com Automated Review Collection ───────────────────────────────────
BOOKING_CRAWLER_ENABLED=true
DEFAULT_COLLECTION_SOURCE=booking
CRAWLER_DELAY_MS=2000
CRAWLER_MAX_PAGES=3
CRAWLER_TIMEOUT_MS=15000

