{
  "name": "azzurro-insights-server",
  "version": "1.0.0",
  "description": "Azzurro Insights — Express.js backend",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/modules/database/migrator.js",
    "db:seed": "node src/modules/database/seed.js",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.13.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "vitest": "^3.1.4"
