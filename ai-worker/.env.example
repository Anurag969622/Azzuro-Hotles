# AI Worker Environment Variables
# Copy to .env and fill in your values.

# Server
PORT=8001
HOST=0.0.0.0

# Shared secret — must match AI_SERVICE_SECRET in server/.env
# Generate with: openssl rand -hex 32
AI_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32

# Model paths — downloaded in Phase 4
MODEL_CACHE_DIR=./models
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
TOPIC_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Phase flags
MODELS_LOADED=false

