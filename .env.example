# ==============================================================================
# AZZURRO INSIGHTS — Consolidated Environment Configuration
# ==============================================================================
# Copy this template into your respective local environment files:
#   - server/.env
#   - client/.env
#   - ai-worker/.env
# NEVER commit .env files containing live credentials or production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
TIMEZONE=Australia/Sydney

# Supabase Credentials (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL Connection URI (Supabase -> Settings -> Database -> Connection string URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# AI Worker Connection & Authentication Secret
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32

# Ingestion Limits & Automation
MAX_IMPORT_FILE_SIZE_MB=10
AI_BATCH_SIZE=50
COLLECTION_CRON_SCHEDULE="0 2 * * *"

# Browser Scraping Safety (Keep FALSE — Playwright remains disabled by default)
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. CLIENT CONFIGURATION (client/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 3. AI WORKER CONFIGURATION (ai-worker/.env)
# ------------------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0
AI_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32
MODEL_CACHE_DIR=./models
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
TOPIC_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODELS_LOADED=false
